---
import { STATIC_PHOTOS } from '../../lib/admin-products.ts';
import { listJson, type ProductRow } from '../../lib/catalog.ts';

interface Props {
  p?: Partial<ProductRow>;
  csrf: string;
  readonly?: boolean;
}
const { p = {}, csrf, readonly = false } = Astro.props;
const join = (s?: string) => listJson(s ?? '[]').join('\n');
---

<form method="post" class="adm-form">
  <input type="hidden" name="_csrf" value={csrf} />
  <input type="hidden" name="action" value="product" />
  <fieldset class="adm-fieldset" disabled={readonly}>
    <div class="adm-grid adm-grid--3">
      <label class="field"><span>Código</span><input class="input" name="code" required maxlength="16" value={p.code ?? ''} placeholder="CPO" /></label>
      <label class="field"><span>Identificador de URL</span><input class="input" name="slug" required maxlength="64" pattern="[a-z0-9]+(-[a-z0-9]+)*" value={p.slug ?? ''} placeholder="rbd-palm-oil" /></label>
      <label class="field"><span>Orden</span><input class="input" name="sort" type="number" min="0" max="99999" value={p.sort ?? 100} /></label>
      <label class="field">
        <span>Tipo de venta</span>
        <select class="input" name="kind">
          <option value="quote" selected={p.kind !== 'direct'}>Bajo cotización</option>
          <option value="direct" selected={p.kind === 'direct'}>Compra directa (tienda)</option>
        </select>
      </label>
      <label class="field">
        <span>Estado</span>
        <select class="input" name="status">
          <option value="active" selected={!p.status || p.status === 'active'}>Activo (visible)</option>
          <option value="inactive" selected={p.status === 'inactive'}>Desactivado (oculto)</option>
          <option value="archived" selected={p.status === 'archived'}>Archivado</option>
        </select>
      </label>
      <label class="field">
        <span>Fotografía de la galería</span>
        <select class="input" name="photo">
          <option value="">Sin fotografía (ficha tipográfica)</option>
          {STATIC_PHOTOS.map((n) => <option value={n} selected={p.photo === n}>{n}</option>)}
        </select>
      </label>
    </div>
    <div class="adm-grid adm-grid--2">
      <div class="adm-form">
        <p class="adm-lang">Español</p>
        <label class="field"><span>Nombre</span><input class="input" name="name_es" required maxlength="120" value={p.name_es ?? ''} /></label>
        <label class="field"><span>Subtítulo</span><input class="input" name="subtitle_es" maxlength="120" value={p.subtitle_es ?? ''} /></label>
        <label class="field"><span>Descripción breve</span><textarea class="input" name="description_es" maxlength="600" rows="3">{p.description_es ?? ''}</textarea></label>
        <label class="field"><span>Características (una por línea)</span><textarea class="input" name="features_es" rows="4">{join(p.features_es)}</textarea></label>
        <label class="field"><span>Aplicaciones (una por línea)</span><textarea class="input" name="applications_es" rows="4">{join(p.applications_es)}</textarea></label>
      </div>
      <div class="adm-form">
        <p class="adm-lang">English</p>
        <label class="field"><span>Name</span><input class="input" name="name_en" required maxlength="120" value={p.name_en ?? ''} /></label>
        <label class="field"><span>Subtitle</span><input class="input" name="subtitle_en" maxlength="120" value={p.subtitle_en ?? ''} /></label>
        <label class="field"><span>Short description</span><textarea class="input" name="description_en" maxlength="600" rows="3">{p.description_en ?? ''}</textarea></label>
        <label class="field"><span>Characteristics (one per line)</span><textarea class="input" name="features_en" rows="4">{join(p.features_en)}</textarea></label>
        <label class="field"><span>Applications (one per line)</span><textarea class="input" name="applications_en" rows="4">{join(p.applications_en)}</textarea></label>
      </div>
    </div>
    <p class="adm-help">No publique especificaciones técnicas, certificaciones ni datos que la empresa no haya documentado.</p>
    {!readonly && <div class="adm-actions"><button class="adm-btn" type="submit">Guardar producto</button></div>}
  </fieldset>
</form>
