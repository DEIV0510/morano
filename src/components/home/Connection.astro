---
// Conexión Colombia → Europa. Solo se marcan los dos puntos documentados
// (Colombia, origen industrial; Madrid, plataforma comercial). Los "mercados
// internacionales" se representan con ondas desde Madrid, sin trazar destinos.
import map from '../../data/map.json';
import { SECTIONS, type Locale } from '../../lib/i18n.ts';
import type { CopyMap } from '../../lib/copy.ts';

interface Props {
  locale: Locale;
  copy: CopyMap;
}
const { locale, copy } = Astro.props;
const es = locale === 'es';
const { width: W, height: H, points } = map;
const co = points.colombia;
const md = points.madrid;
const arc = `M${co.x} ${co.y} C ${co.x + 120} ${co.y - 210}, ${md.x - 230} ${md.y - 120}, ${md.x} ${md.y}`;
const nodes = [
  { n: '01', name: 'Colombia', text: copy['connection.colombia'] },
  { n: '02', name: es ? 'Europa · Madrid' : 'Europe · Madrid', text: copy['connection.europe'] },
  { n: '03', name: es ? 'Mercados internacionales' : 'International markets', text: copy['connection.markets'] },
];
---

<section class="section connection" id={SECTIONS[locale].connection} aria-labelledby="connection-title">
  <div class="wrap">
    <h2 id="connection-title" class="h2 connection__title reveal">
      <span>{copy['connection.title1']}</span>
      <span class="connection__title-2">{copy['connection.title2']}</span>
    </h2>

    <div class="connection__body">
    <figure class="connection__map" data-map>
      <img class="connection__dots" src="/img/mapa-puntos.svg" width={W} height={H} alt="" loading="lazy" decoding="async" />
      <svg class="connection__routes" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
        <path class="connection__arc-base" d={arc} />
        <path class="connection__arc" d={arc} pathLength="100" />
        <g class="connection__waves">
          <circle cx={md.x} cy={md.y} r="30" />
          <circle cx={md.x} cy={md.y} r="30" />
          <circle cx={md.x} cy={md.y} r="30" />
        </g>
        <circle class="connection__node connection__node--co" cx={co.x} cy={co.y} r="7" />
        <circle class="connection__node connection__node--md" cx={md.x} cy={md.y} r="7" />
        <circle class="connection__traveller" r="4.5" cx="0" cy="0">
          <animateMotion dur="3.6s" repeatCount="indefinite" begin="indefinite" path={arc} keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines="0.6 0 0.3 1" />
        </circle>
      </svg>
      <span class="connection__label connection__label--co"><span class="num">01</span> Colombia</span>
      <span class="connection__label connection__label--md"><span class="num">02</span> Madrid</span>
      <figcaption class="visually-hidden">
        {es ? 'Mapa estilizado: conexión entre las operaciones industriales en Colombia y la plataforma comercial en Madrid.' : 'Stylised map: connection between the industrial operations in Colombia and the commercial platform in Madrid.'}
      </figcaption>
    </figure>

    <ol class="connection__nodes" role="list">
      {
        nodes.map((node, i) => (
          <li class="connection__item reveal" data-delay={i * 120}>
            <span class="connection__n num">{node.n}</span>
            <h3 class="h3">{node.name}</h3>
            <p>{node.text}</p>
          </li>
        ))
      }
    </ol>
    </div>
  </div>
</section>
