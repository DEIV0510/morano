---
// Formulario de cotización (modal). Se abre desde cualquier botón con
// data-quote-open; data-product="slug" preselecciona el producto.
// Al enviar, abre WhatsApp con la solicitud ya redactada.
import Icon from './Icon.astro';
import { quotableProducts } from '../lib/catalog.ts';
import { COUNTRY_CODES } from '../lib/countries.ts';
import { t, type Locale } from '../lib/i18n.ts';
import { L, PHONE_PATTERN } from '../lib/limits.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const products = await quotableProducts(locale);
---

<dialog id="quote-dialog" class="modal" aria-labelledby="quote-title">
  <div class="modal__panel">
    <div class="modal__head">
      <div>
        <h2 id="quote-title" class="h3">{t(locale, 'quote.title')}</h2>
        <p class="muted modal__lead">{t(locale, 'quote.lead')}</p>
      </div>
      <button class="icon-btn" type="button" data-dialog-close><Icon name="close" /><span class="visually-hidden">{t(locale, 'common.close')}</span></button>
    </div>
    <form class="form-grid" data-form="quote" novalidate>
      <label class="field">
        <span>{t(locale, 'form.fullName')}</span>
        <input class="input" name="fullName" required minlength={L.name.min} maxlength={L.name.max} autocomplete="name" />
      </label>
      <label class="field">
        <span>{t(locale, 'form.company')}</span>
        <input class="input" name="company" required minlength={L.company.min} maxlength={L.company.max} autocomplete="organization" />
      </label>
      <label class="field">
        <span>{t(locale, 'form.email')} <span class="opt">({t(locale, 'common.optional')})</span></span>
        <input class="input" type="email" name="email" maxlength={L.email.max} autocomplete="email" />
      </label>
      <label class="field">
        <span>{t(locale, 'form.phone')} <span class="opt">({t(locale, 'common.optional')})</span></span>
        <input class="input" type="tel" name="phone" pattern={PHONE_PATTERN} maxlength={L.phone.max} autocomplete="tel" />
      </label>
      <label class="field">
        <span>{t(locale, 'form.country')}</span>
        {/* Las opciones se generan al abrir el modal (Intl.DisplayNames): ~250 nodos menos en cada página. */}
        <select class="input" name="country" required autocomplete="country" data-country-select data-codes={COUNTRY_CODES.join(' ')} data-locale={locale}>
          <option value="">{t(locale, 'form.countryPick')}</option>
        </select>
      </label>
      <label class="field">
        <span>{t(locale, 'form.product')}</span>
        <select class="input" name="product" required data-quote-product>
          {products.map((p) => <option value={`${p.code} — ${p.name}`} data-slug={p.slug}>{p.code} — {p.name}</option>)}
          <option value={t(locale, 'form.productOther')} data-slug="other">{t(locale, 'form.productOther')}</option>
        </select>
      </label>
      <label class="field field--full">
        <span>{t(locale, 'form.volume')}</span>
        <input class="input" name="volume" required minlength={L.volume.min} maxlength={L.volume.max} placeholder={t(locale, 'form.volumeHint')} data-quote-volume />
      </label>
      <label class="field field--full">
        <span>{t(locale, 'form.needs')} <span class="opt">({t(locale, 'common.optional')})</span></span>
        <textarea class="input" name="needs" rows="4" maxlength={L.needs.max}></textarea>
      </label>
      <div class="form-actions field--full">
        <p class="form-status" data-form-status role="status" aria-live="polite">{t(locale, 'form.whatsappNote')}</p>
        <button class="btn" type="submit">{t(locale, 'quote.submit')} <Icon name="whatsapp" size={18} /></button>
      </div>
    </form>
    <div class="form-done" data-form-done hidden tabindex="-1">
      <span class="form-done__icon"><Icon name="check" size={28} /></span>
      <h3 class="h3">{t(locale, 'form.sentTitle')}</h3>
      <p class="muted">{t(locale, 'form.sentText')}</p>
      <div class="adm-inline">
        <a class="btn" href="#" data-wa-again target="_blank" rel="noopener">{t(locale, 'form.openAgain')}</a>
        <button class="btn btn--outline" type="button" data-dialog-close>{t(locale, 'common.close')}</button>
      </div>
    </div>
  </div>
</dialog>
