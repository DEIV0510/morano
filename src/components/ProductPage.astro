---
import Base from '../layouts/Base.astro';
import ProductBuy from './ProductBuy.astro';
import Picture from './Picture.astro';
import Icon from './Icon.astro';
import NotFound from './NotFound.astro';
import images from '../data/images.json';
import { config } from '../lib/config.ts';
import { productBySlug } from '../lib/catalog.ts';
import { ROUTES, route, SECTIONS, t, type Locale } from '../lib/i18n.ts';
import { getSettings } from '../lib/settings.ts';
import { mediaUrl } from '../lib/media.ts';

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const settings = await getSettings();
const p = /^[a-z0-9-]{2,64}$/.test(slug) ? await productBySlug(slug, locale, settings.lowStockDefault) : undefined;

const site = config.siteUrl;
const alternates = { es: ROUTES.product.es + slug, en: ROUTES.product.en + slug };
const home = route('home', locale);
const S = SECTIONS[locale];
const photo = p?.photo && p.photo in images ? (p.photo as keyof typeof images) : undefined;
const uploaded = p?.images[0];
const priced = p?.variants.filter((v) => v.priceCents) ?? [];

const jsonLd = p
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'Product',
        name: `${p.code} — ${p.name}`,
        description: p.description,
        sku: p.code,
        category: locale === 'es' ? 'Aceites y grasas vegetales' : 'Vegetable oils and fats',
        brand: { '@type': 'Brand', name: 'Morano Europe' },
        manufacturer: { '@type': 'Organization', name: 'Morano Gruppo', url: 'https://moranogruppo.com/' },
        countryOfOrigin: 'CO',
        url: `${site}${route('product', locale, p.slug)}`,
        ...(uploaded ? { image: `${site}${mediaUrl(uploaded.mediaId, 1600)}` } : photo ? { image: `${site}/img/${photo}-${images[photo].widths.at(-1)}.jpg` } : {}),
        ...(priced.length
          ? {
              offers: priced.map((v) => ({
                '@type': 'Offer',
                sku: v.sku,
                name: v.label,
                price: (v.priceCents! / 100).toFixed(2),
                priceCurrency: 'EUR',
                availability: v.available ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
                url: `${site}${route('product', locale, p.slug)}`,
                seller: { '@id': `${site}/#organization` },
              })),
            }
          : {}),
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Morano Europe', item: `${site}${home}` },
          { '@type': 'ListItem', position: 2, name: t(locale, 'nav.products'), item: `${site}${home}#${S.products}` },
          { '@type': 'ListItem', position: 3, name: p.name, item: `${site}${route('product', locale, p.slug)}` },
        ],
      },
    ]
  : [];
const title = p ? `${p.code} — ${p.name} | Morano Europe` : `${t(locale, 'error.404.title')} | Morano Europe`;
const description = p ? `${p.description} ${p.kind === 'direct' ? (locale === 'es' ? 'Compra directa en formatos de 500 g a 20 kg.' : 'Direct purchase in 500 g to 20 kg pack sizes.') : locale === 'es' ? 'Solicite cotización para volúmenes industriales.' : 'Request a quote for industrial volumes.'}` : undefined;
---

<Base locale={locale} alternates={alternates} title={title} description={description} jsonLd={jsonLd} noindex={!p}>
  {
    !p ? (
      <NotFound locale={locale} />
    ) : (
      <>
        <header class="page-head">
          <div class="wrap">
            <ol class="breadcrumb" role="list">
              <li><a href={home}>Morano Europe</a></li>
              <li><a href={`${home}#${S.products}`}>{t(locale, 'nav.products')}</a></li>
              <li aria-current="page">{p.code}</li>
            </ol>
            <h1 class="h2">{p.code} — {p.name}</h1>
          </div>
        </header>
        <section class="pdp wrap">
          <div class="grid pdp__grid">
            <div class="pdp__media">
              {uploaded ? (
                <div class="framed"><div class="photo">
                  <img src={mediaUrl(uploaded.mediaId, 960)} srcset={`${mediaUrl(uploaded.mediaId, 480)} 480w, ${mediaUrl(uploaded.mediaId, 960)} 960w, ${mediaUrl(uploaded.mediaId, 1600)} 1600w`} sizes="(min-width: 1024px) 46vw, 92vw" width={uploaded.width} height={uploaded.height} alt={uploaded.alt} />
                </div></div>
              ) : photo ? (
                <div class="framed"><div class="photo">
                  <Picture name={photo} alt={p.name} sizes="(min-width: 1024px) 46vw, 92vw" priority />
                </div></div>
              ) : (
                <div class="pdp__media--type framed">
                  <span class="pdp__big">{p.code}</span>
                  <svg viewBox="152 20 236 178" aria-hidden="true"><use href="#me-mark" /></svg>
                </div>
              )}
            </div>
            <div class="pdp__info">
              {p.kind === 'direct' ? (
                <ProductBuy product={p} locale={locale} vatIncluded={settings.pricesIncludeVat} headingLevel="h2" showMedia={false} />
              ) : (
                <div class="pdp__quote">
                  <p class="buy__sub">{p.subtitle}</p>
                  <p class="lead">{p.description}</p>
                  <button class="btn" type="button" data-quote-open data-product={p.slug}>{t(locale, 'common.requestQuote')} <Icon name="arrow" /></button>
                </div>
              )}
              <div class="pdp__lists">
                <div>
                  <h2>{t(locale, 'common.characteristics')}</h2>
                  <ul role="list">{p.features.map((f) => <li>{f}</li>)}</ul>
                </div>
                <div>
                  <h2>{t(locale, 'common.applications')}</h2>
                  <ul role="list">{p.applications.map((a) => <li>{a}</li>)}</ul>
                </div>
              </div>
              <a class="link" href={`${home}#${S.products}`}>{t(locale, 'common.back')}</a>
            </div>
          </div>
        </section>
      </>
    )
  }
</Base>
