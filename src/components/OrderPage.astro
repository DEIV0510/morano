---
// Confirmación y seguimiento del pedido. Acceso solo con el enlace privado
// (token) o con la sesión de Stripe del propio pedido. El estado "pagado" lo
// fija únicamente el webhook firmado de Stripe, nunca esta redirección.
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { contact } from '../lib/config.ts';
import { countryName } from '../lib/countries.ts';
import type { findOrderForCustomer } from '../lib/orders.ts';
import { formatMoney } from '../lib/pricing.ts';
import { ROUTES, route, t, type Locale } from '../lib/i18n.ts';

interface Props {
  locale: Locale;
  ref: string;
  found: Awaited<ReturnType<typeof findOrderForCustomer>>;
}
const { locale, ref, found } = Astro.props;
const q = Astro.url.searchParams;
const token = q.get('t');
const sessionId = q.get('session_id');
const cancelled = q.get('cancelled') === '1';
const tries = Math.min(20, Number(q.get('r') || 0) || 0);
const o = found?.order;
const m = (c: number) => formatMoney(c, locale);
const awaiting = o && o.payment_method === 'stripe' && o.status === 'pending' && !cancelled && sessionId;
let refreshUrl = '';
if (awaiting && tries < 12) {
  const u = new URLSearchParams(q);
  u.set('r', String(tries + 1));
  refreshUrl = `${Astro.url.pathname}?${u.toString()}`;
}
const wa = `https://wa.me/${contact.whatsappDigits}?text=${encodeURIComponent(`${t(locale, 'whatsapp.message')} ${ref}`)}`;
const heading = !o
  ? t(locale, 'order.title')
  : o.status === 'pending' && o.payment_method === 'proforma'
    ? t(locale, 'order.received')
    : o.status === 'pending' && cancelled
      ? t(locale, 'order.cancelled')
      : o.status === 'pending'
        ? t(locale, 'order.awaitingPayment')
        : o.status === 'paid'
          ? t(locale, 'order.paid')
          : t(locale, `status.${o.status}` as any);
const text = !o
  ? t(locale, 'order.notFound')
  : o.status === 'pending' && o.payment_method === 'proforma'
    ? t(locale, 'order.receivedProforma')
    : o.status === 'pending' && cancelled
      ? t(locale, 'order.cancelledText')
      : o.status === 'pending'
        ? t(locale, 'order.awaitingPaymentText')
        : o.status === 'paid'
          ? t(locale, 'order.paidText')
          : '';
---

<Base locale={locale} alternates={{ es: ROUTES.order.es + ref, en: ROUTES.order.en + ref }} title={`${t(locale, 'order.title')} ${o ? o.ref : ''} | Morano Europe`} noindex>
  {refreshUrl && <meta slot="head" http-equiv="refresh" content={`4;url=${refreshUrl}`} />}
  <header class="page-head">
    <div class="wrap">
      <h1 class="h2">{heading}</h1>
    </div>
  </header>
  <section class="wrap checkout">
    <div class="grid checkout__grid">
      <div class="checkout__form">
        <div class="order-status">
          {o && <p class="order-status__badge">{t(locale, 'order.status')}: {t(locale, `status.${o.status}` as any)}</p>}
          {o && <p class="h3">{t(locale, 'common.reference')}: <span class="num">{o.ref}</span></p>}
          <p class="muted">{text}</p>
          {
            o && o.status === 'pending' && o.payment_method === 'stripe' && cancelled && (
              <form method="post" action="/api/orders/retry">
                <input type="hidden" name="ref" value={o.ref} />
                {token && <input type="hidden" name="t" value={token} />}
                {sessionId && <input type="hidden" name="session_id" value={sessionId} />}
                <button class="btn" type="submit">{t(locale, 'order.retryPayment')} <Icon name="arrow" /></button>
              </form>
            )
          }
          <a class="link" href={wa} target="_blank" rel="noopener">WhatsApp {contact.whatsapp}</a>
        </div>
        {
          o && (
            <p class="muted">
              {o.customer_name}
              {o.company ? ` · ${o.company}` : ''}
              <br />
              {[o.address_line1, o.address_line2, `${o.postal_code} ${o.city}`, countryName(o.country, locale)].filter(Boolean).join(', ')}
            </p>
          )
        }
      </div>
      {
        found && o && (
          <aside class="checkout__summary">
            <h2>{t(locale, 'order.items')}</h2>
            <table class="order-table">
              <tbody>
                {found.items.map((i) => (
                  <tr>
                    <td>
                      {i.qty} × {i.product_name}
                      <br />
                      <span class="muted">{i.variant_label}</span>
                    </td>
                    <td class="num">{m(i.line_total_cents)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <dl class="totals">
              <dt>{t(locale, 'cart.subtotal')}</dt>
              <dd class="num">{m(o.subtotal_cents)}</dd>
              <dt>{t(locale, 'cart.shipping')}</dt>
              <dd>{o.shipping_cents === null ? t(locale, 'cart.shippingPending') : o.shipping_cents === 0 ? t(locale, 'cart.shippingFree') : m(o.shipping_cents)}</dd>
              <dt>{o.vat_included ? t(locale, 'cart.vatIncludedLine') : t(locale, 'cart.vat')}</dt>
              <dd class="num">{m(o.vat_cents)}</dd>
              <dt class="totals__total">{t(locale, 'cart.total')}</dt>
              <dd class="totals__total num">{m(o.total_cents)}</dd>
            </dl>
          </aside>
        )
      }
    </div>
    <p><a class="link" href={route('home', locale)}>Morano Europe</a></p>
  </section>
</Base>
