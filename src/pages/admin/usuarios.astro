---
// Usuarios del panel y roles. Solo administradores.
import Admin from '../../layouts/Admin.astro';
import { destroyUserSessions, passwordProblem, ROLE_LABEL, ROLES, type Role } from '../../lib/auth.ts';
import { fmtDate, FormError, guard, readForm, str } from '../../lib/admin.ts';
import { audit } from '../../lib/audit.ts';
import { all, get, run } from '../../lib/db.ts';
import { hashPassword } from '../../lib/security/crypto.ts';

const g = guard(Astro, 'users:manage');
if (g instanceof Response) return g;
const { user, session } = g;
const OK: Record<string, string> = { creado: 'Usuario creado. Deberá cambiar la contraseña en su primer acceso.', guardado: 'Usuario actualizado.', mfa: 'Verificación en dos pasos restablecida.', eliminado: 'Usuario eliminado.', clave: 'Contraseña temporal asignada.' };
let flash: { kind: 'ok' | 'error'; text: string } | null = OK[Astro.url.searchParams.get('ok') || ''] ? { kind: 'ok', text: OK[Astro.url.searchParams.get('ok')!] } : null;

async function adminsLeft(excludeId: number) {
  return (await get<{ n: number }>("SELECT COUNT(*) AS n FROM users WHERE role = 'admin' AND active = 1 AND id <> ?", [excludeId]))?.n ?? 0;
}

if (Astro.request.method === 'POST') {
  try {
    const fd = await readForm(Astro, g);
    const action = str(fd, 'action', 20);
    if (action === 'create') {
      const email = str(fd, 'email', 254).toLowerCase();
      const name = str(fd, 'name', 80);
      const role = str(fd, 'role', 10) as Role;
      const pw = String(fd.get('password') ?? '');
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) throw new FormError('Correo no válido.');
      if (!name) throw new FormError('Indique el nombre.');
      if (!ROLES.includes(role)) throw new FormError('Rol no válido.');
      const problem = passwordProblem(pw, email);
      if (problem) throw new FormError(`Contraseña temporal no válida: ${problem}`);
      if (await get('SELECT id FROM users WHERE email = ?', [email])) throw new FormError('Ya existe un usuario con ese correo.');
      const now = Date.now();
      const r = await run('INSERT INTO users (email, name, role, password_hash, active, must_change_password, password_changed_at, created_at) VALUES (?, ?, ?, ?, 1, 1, ?, ?)', [email, name, role, await hashPassword(pw), now, now]);
      await audit(user, 'user.create', 'user', r.lastId, { email, role }, g.ipHash);
      return Astro.redirect('/admin/usuarios?ok=creado', 303);
    }
    const uid = Number(fd.get('uid'));
    const target = await get<{ id: number; email: string; role: Role; active: number }>('SELECT id, email, role, active FROM users WHERE id = ?', [uid]);
    if (!target) throw new FormError('Usuario no encontrado.');

    if (action === 'update') {
      const role = str(fd, 'role', 10) as Role;
      const active = fd.get('active') === '1' ? 1 : 0;
      if (!ROLES.includes(role)) throw new FormError('Rol no válido.');
      if (target.id === user.id && (role !== 'admin' || !active)) throw new FormError('No puede quitarse a sí mismo el rol de administrador ni desactivarse.');
      if (target.role === 'admin' && (role !== 'admin' || !active) && (await adminsLeft(target.id)) === 0) throw new FormError('Debe quedar al menos un administrador activo.');
      await run('UPDATE users SET role = ?, active = ? WHERE id = ?', [role, active, uid]);
      if (!active || role !== target.role) await destroyUserSessions(uid);
      await audit(user, 'user.update', 'user', uid, { role, active }, g.ipHash);
      return Astro.redirect('/admin/usuarios?ok=guardado', 303);
    }
    if (action === 'reset_mfa') {
      if (fd.get('confirmed') !== '1') throw new FormError('Confirme la acción.');
      await run('UPDATE users SET mfa_enabled = 0, mfa_secret_enc = NULL, mfa_last_step = 0 WHERE id = ?', [uid]);
      await destroyUserSessions(uid);
      await audit(user, 'user.mfa_reset', 'user', uid, {}, g.ipHash);
      return Astro.redirect('/admin/usuarios?ok=mfa', 303);
    }
    if (action === 'reset_password') {
      const pw = String(fd.get('password') ?? '');
      const problem = passwordProblem(pw, target.email);
      if (problem) throw new FormError(`Contraseña temporal no válida: ${problem}`);
      await run('UPDATE users SET password_hash = ?, must_change_password = 1, password_changed_at = ?, failed_count = 0, locked_until = 0 WHERE id = ?', [await hashPassword(pw), Date.now(), uid]);
      await destroyUserSessions(uid);
      await audit(user, 'user.password_reset', 'user', uid, {}, g.ipHash);
      return Astro.redirect('/admin/usuarios?ok=clave', 303);
    }
    if (action === 'delete') {
      if (fd.get('confirmed') !== '1') throw new FormError('Confirme la eliminación.');
      if (target.id === user.id) throw new FormError('No puede eliminar su propia cuenta.');
      if (target.role === 'admin' && (await adminsLeft(target.id)) === 0) throw new FormError('Debe quedar al menos un administrador activo.');
      await run('DELETE FROM users WHERE id = ?', [uid]);
      await audit(user, 'user.delete', 'user', uid, { email: target.email }, g.ipHash);
      return Astro.redirect('/admin/usuarios?ok=eliminado', 303);
    }
    throw new FormError('Acción desconocida.');
  } catch (e) {
    if (e instanceof FormError) flash = { kind: 'error', text: e.message };
    else throw e;
  }
}

const users = await all<{ id: number; email: string; name: string; role: Role; active: number; mfa_enabled: number; last_login_at: number | null; locked_until: number }>(
  'SELECT id, email, name, role, active, mfa_enabled, last_login_at, locked_until FROM users ORDER BY role, name'
);
---

<Admin title="Usuarios y roles" user={user} csrf={session.csrf} active="users" flash={flash}>
  <section class="adm-card">
    <h2>Permisos por rol</h2>
    <ul class="check-list">
      <li><span>·</span><span><strong>Administrador</strong>: todo, incluidos usuarios, ajustes, registro de actividad y borrado de productos.</span></li>
      <li><span>·</span><span><strong>Gestor de catálogo y contenidos</strong>: productos, precios, inventario, textos, pedidos, cotizaciones y mensajes.</span></li>
      <li><span>·</span><span><strong>Comercial</strong>: pedidos, cotizaciones y mensajes; catálogo en solo lectura.</span></li>
      <li><span>·</span><span><strong>Consulta</strong>: solo lectura de resumen, pedidos, cotizaciones, mensajes y catálogo.</span></li>
    </ul>
  </section>
  <section class="adm-card">
    <h2>Usuarios</h2>
    <div class="adm-table-wrap">
      <table class="adm-table adm-table--stack">
        <thead><tr><th>Usuario</th><th>Rol y estado</th><th>2 pasos</th><th>Último acceso</th><th>Acciones</th></tr></thead>
        <tbody>
          {users.map((u) => (
            <tr>
              <td data-label="Usuario"><strong>{u.name}</strong><br /><span class="adm-help">{u.email}</span>{u.locked_until > Date.now() && <><br /><span class="tag tag--failed">Bloqueado temporalmente</span></>}</td>
              <td data-label="Rol">
                <form method="post" class="adm-inline">
                  <input type="hidden" name="_csrf" value={session.csrf} />
                  <input type="hidden" name="action" value="update" />
                  <input type="hidden" name="uid" value={u.id} />
                  <select class="input input--sm" name="role" aria-label={`Rol de ${u.email}`}>
                    {ROLES.map((r) => <option value={r} selected={r === u.role}>{ROLE_LABEL[r]}</option>)}
                  </select>
                  <select class="input input--sm" name="active" aria-label={`Estado de ${u.email}`}>
                    <option value="1" selected={u.active === 1}>Activo</option>
                    <option value="0" selected={u.active === 0}>Desactivado</option>
                  </select>
                  <button class="adm-btn adm-btn--sm" type="submit">Guardar</button>
                </form>
              </td>
              <td data-label="2 pasos"><span class={`tag tag--${u.mfa_enabled ? 'active' : 'inactive'}`}>{u.mfa_enabled ? 'Activa' : 'No'}</span></td>
              <td data-label="Último acceso" class="muted">{fmtDate(u.last_login_at)}</td>
              <td data-label="Acciones">
                <div class="adm-actions">
                  <form method="post" class="adm-inline">
                    <input type="hidden" name="_csrf" value={session.csrf} />
                    <input type="hidden" name="action" value="reset_password" />
                    <input type="hidden" name="uid" value={u.id} />
                    <input class="input input--sm" type="password" name="password" placeholder="Contraseña temporal" autocomplete="new-password" minlength="12" required aria-label={`Contraseña temporal para ${u.email}`} />
                    <button class="adm-btn adm-btn--ghost adm-btn--sm" type="submit">Restablecer</button>
                  </form>
                  {u.mfa_enabled === 1 && (
                    <form method="post" data-confirm={`¿Desactivar la verificación en dos pasos de ${u.email}? Deberá configurarla de nuevo.`}>
                      <input type="hidden" name="_csrf" value={session.csrf} />
                      <input type="hidden" name="action" value="reset_mfa" />
                      <input type="hidden" name="uid" value={u.id} />
                      <button class="adm-btn adm-btn--ghost adm-btn--sm" type="submit">Restablecer 2 pasos</button>
                    </form>
                  )}
                  {u.id !== user.id && (
                    <form method="post" data-confirm={`¿Eliminar definitivamente a ${u.email}?`}>
                      <input type="hidden" name="_csrf" value={session.csrf} />
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="uid" value={u.id} />
                      <button class="adm-btn adm-btn--danger adm-btn--sm" type="submit">Eliminar</button>
                    </form>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  <section class="adm-card">
    <h2>Nuevo usuario</h2>
    <form method="post" class="adm-form">
      <input type="hidden" name="_csrf" value={session.csrf} />
      <input type="hidden" name="action" value="create" />
      <div class="adm-grid adm-grid--2">
        <label class="field"><span>Nombre</span><input class="input" name="name" required maxlength="80" /></label>
        <label class="field"><span>Correo</span><input class="input" type="email" name="email" required maxlength="254" autocomplete="off" /></label>
        <label class="field">
          <span>Rol</span>
          <select class="input" name="role">{ROLES.map((r) => <option value={r} selected={r === 'sales'}>{ROLE_LABEL[r]}</option>)}</select>
        </label>
        <label class="field"><span>Contraseña temporal</span><input class="input" type="password" name="password" required minlength="12" autocomplete="new-password" /></label>
      </div>
      <p class="adm-help">Mínimo 12 caracteres combinando mayúsculas, minúsculas, números o símbolos. Comuníquela por un canal seguro: se pedirá cambiarla en el primer acceso.</p>
      <div class="adm-actions"><button class="adm-btn" type="submit">Crear usuario</button></div>
    </form>
  </section>
</Admin>
