---
// Cuenta propia: cambio de contraseña y verificación en dos pasos (TOTP).
import Admin from '../../layouts/Admin.astro';
import { renderSVG } from 'uqr';
import { COOKIE, cookieOptions, createSession, destroyUserSessions, passwordProblem, type UserRow } from '../../lib/auth.ts';
import { FormError, readForm } from '../../lib/admin.ts';
import { audit } from '../../lib/audit.ts';
import { get, run } from '../../lib/db.ts';
import { clientIp } from '../../lib/http.ts';
import { decrypt, encrypt, hashIp, hashPassword, verifyPassword } from '../../lib/security/crypto.ts';
import { newTotpSecret, otpauthUri, verifyTotp } from '../../lib/security/totp.ts';

const auth = Astro.locals.auth;
if (!auth || auth.session.mfa_pending) return Astro.redirect('/admin/login', 303);
const { user, session } = auth;
const g = { user, session, ipHash: hashIp(clientIp(Astro as any)) };
const forced = Astro.url.searchParams.get('forzado') === '1' || user.must_change_password === 1;
const OK: Record<string, string> = { clave: 'Contraseña actualizada. Se cerraron sus otras sesiones.', mfa_on: 'Verificación en dos pasos activada.', mfa_off: 'Verificación en dos pasos desactivada.' };
let flash: { kind: 'ok' | 'error'; text: string } | null = OK[Astro.url.searchParams.get('ok') || ''] ? { kind: 'ok', text: OK[Astro.url.searchParams.get('ok')!] } : null;

const me = (await get<UserRow>('SELECT * FROM users WHERE id = ?', [user.id]))!;

if (Astro.request.method === 'POST') {
  try {
    const fd = await readForm(Astro, g);
    const action = String(fd.get('action') || '');
    const current = String(fd.get('current') || '');
    if (action === 'password') {
      const next = String(fd.get('new') || '');
      if (!(await verifyPassword(current, me.password_hash))) throw new FormError('La contraseña actual no es correcta.');
      if (next !== String(fd.get('confirm') || '')) throw new FormError('Las contraseñas nuevas no coinciden.');
      if (await verifyPassword(next, me.password_hash)) throw new FormError('La nueva contraseña debe ser distinta de la actual.');
      const problem = passwordProblem(next, me.email);
      if (problem) throw new FormError(problem);
      await run('UPDATE users SET password_hash = ?, must_change_password = 0, password_changed_at = ? WHERE id = ?', [await hashPassword(next), Date.now(), me.id]);
      // Rota la sesión: se invalidan todas y se crea una nueva para este navegador.
      await destroyUserSessions(me.id);
      const token = await createSession(me.id, false, clientIp(Astro as any), Astro.request.headers.get('user-agent') || '');
      Astro.cookies.set(COOKIE, token, cookieOptions(12 * 60 * 60));
      await audit(user, 'user.password_change', 'user', me.id, {}, g.ipHash);
      return Astro.redirect('/admin/cuenta?ok=clave', 303);
    }
    if (action === 'mfa_start') {
      if (me.mfa_enabled) throw new FormError('La verificación en dos pasos ya está activa.');
      await run('UPDATE users SET mfa_secret_enc = ? WHERE id = ?', [encrypt(newTotpSecret()), me.id]);
      return Astro.redirect('/admin/cuenta?mfa=configurar', 303);
    }
    if (action === 'mfa_confirm') {
      if (me.mfa_enabled || !me.mfa_secret_enc) throw new FormError('Inicie de nuevo la configuración.');
      const step = verifyTotp(decrypt(me.mfa_secret_enc), String(fd.get('code') || '').replace(/\s/g, ''), 0);
      if (step === null) throw new FormError('Código incorrecto. Compruebe la hora del teléfono e inténtelo de nuevo.');
      await run('UPDATE users SET mfa_enabled = 1, mfa_last_step = ? WHERE id = ?', [step, me.id]);
      await audit(user, 'user.mfa_enabled', 'user', me.id, {}, g.ipHash);
      return Astro.redirect('/admin/cuenta?ok=mfa_on', 303);
    }
    if (action === 'mfa_disable') {
      if (!(await verifyPassword(current, me.password_hash))) throw new FormError('La contraseña actual no es correcta.');
      if (!me.mfa_secret_enc || verifyTotp(decrypt(me.mfa_secret_enc), String(fd.get('code') || '').replace(/\s/g, ''), me.mfa_last_step) === null) throw new FormError('Código de verificación incorrecto.');
      await run('UPDATE users SET mfa_enabled = 0, mfa_secret_enc = NULL, mfa_last_step = 0 WHERE id = ?', [me.id]);
      await audit(user, 'user.mfa_disabled', 'user', me.id, {}, g.ipHash);
      return Astro.redirect('/admin/cuenta?ok=mfa_off', 303);
    }
    throw new FormError('Acción desconocida.');
  } catch (e) {
    if (e instanceof FormError) flash = { kind: 'error', text: e.message };
    else throw e;
  }
}

const setup = !me.mfa_enabled && me.mfa_secret_enc && Astro.url.searchParams.get('mfa') === 'configurar';
const secret = setup ? decrypt(me.mfa_secret_enc!) : '';
const qr = setup ? renderSVG(otpauthUri(me.email, secret), { border: 1 }) : '';
---

<Admin title="Mi cuenta" user={user} csrf={session.csrf} active="account" flash={flash}>
  {forced && <p class="adm-warn">Por seguridad, cambie la contraseña temporal antes de continuar.</p>}
  <div class="adm-grid adm-grid--2">
    <section class="adm-card">
      <h2>Cambiar contraseña</h2>
      <form method="post" class="adm-form">
        <input type="hidden" name="_csrf" value={session.csrf} />
        <input type="hidden" name="action" value="password" />
        <label class="field"><span>Contraseña actual</span><input class="input" type="password" name="current" required autocomplete="current-password" maxlength="200" /></label>
        <label class="field"><span>Nueva contraseña</span><input class="input" type="password" name="new" required minlength="12" maxlength="200" autocomplete="new-password" /></label>
        <label class="field"><span>Repita la nueva contraseña</span><input class="input" type="password" name="confirm" required minlength="12" maxlength="200" autocomplete="new-password" /></label>
        <p class="adm-help">Mínimo 12 caracteres; combine al menos tres de: minúsculas, mayúsculas, números y símbolos. Mejor una frase larga.</p>
        <div class="adm-actions"><button class="adm-btn" type="submit">Guardar contraseña</button></div>
      </form>
    </section>
    <section class="adm-card">
      <h2>Verificación en dos pasos</h2>
      {
        me.mfa_enabled ? (
          <form method="post" class="adm-form">
            <p class="adm-help">Activa. Al entrar se pide un código de su aplicación de autenticación.</p>
            <input type="hidden" name="_csrf" value={session.csrf} />
            <input type="hidden" name="action" value="mfa_disable" />
            <label class="field"><span>Contraseña actual</span><input class="input" type="password" name="current" required autocomplete="current-password" /></label>
            <label class="field"><span>Código actual</span><input class="input" name="code" inputmode="numeric" maxlength="7" required autocomplete="one-time-code" /></label>
            <div class="adm-actions"><button class="adm-btn adm-btn--danger" type="submit">Desactivar</button></div>
          </form>
        ) : setup ? (
          <form method="post" class="adm-form">
            <p class="adm-help">1. Escanee el código con Google Authenticator, Microsoft Authenticator, 1Password o similar. 2. Escriba el código de 6 dígitos que aparece.</p>
            <div class="adm-qr" set:html={qr} />
            <p class="adm-help">Clave manual: <span class="adm-secret">{secret.match(/.{1,4}/g)?.join(' ')}</span></p>
            <input type="hidden" name="_csrf" value={session.csrf} />
            <input type="hidden" name="action" value="mfa_confirm" />
            <label class="field"><span>Código de 6 dígitos</span><input class="input" name="code" inputmode="numeric" maxlength="7" required autocomplete="one-time-code" /></label>
            <div class="adm-actions"><button class="adm-btn" type="submit">Activar</button></div>
          </form>
        ) : (
          <form method="post" class="adm-form">
            <p class="adm-help">Añade un segundo factor (código temporal del móvil) al acceso. Recomendado para todos los usuarios y obligatorio en la práctica para administradores.</p>
            <input type="hidden" name="_csrf" value={session.csrf} />
            <input type="hidden" name="action" value="mfa_start" />
            <div class="adm-actions"><button class="adm-btn adm-btn--gold" type="submit">Configurar</button></div>
          </form>
        )
      }
    </section>
  </div>
</Admin>
