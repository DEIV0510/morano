---
import Admin from '../../../layouts/Admin.astro';
import ProductForm from '../../../components/admin/ProductForm.astro';
import { can } from '../../../lib/auth.ts';
import { centsToInput, FormError, guard, parseEuros, parseIntOrNull, readForm, str } from '../../../lib/admin.ts';
import { parseProduct, saveProduct } from '../../../lib/admin-products.ts';
import { audit } from '../../../lib/audit.ts';
import { all, batch, get, run } from '../../../lib/db.ts';
import { ApiError } from '../../../lib/http.ts';
import { mediaUrl, storeImage } from '../../../lib/media.ts';
import { consume, LIMITS } from '../../../lib/security/ratelimit.ts';
import { route } from '../../../lib/i18n.ts';
import type { ProductRow, VariantRow } from '../../../lib/catalog.ts';

const g = guard(Astro, 'catalog:read');
if (g instanceof Response) return g;
const { user, session } = g;
const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect('/admin/productos', 303);

const OK: Record<string, string> = {
  creado: 'Producto creado. Añada ahora sus presentaciones o imágenes.',
  guardado: 'Producto guardado.',
  presentaciones: 'Presentaciones, precios e inventario guardados.',
  presentacion: 'Presentación añadida.',
  eliminada: 'Presentación eliminada.',
  imagen: 'Imagen subida.',
  imagen_eliminada: 'Imagen eliminada.',
};
const okKey = Astro.url.searchParams.get('ok') || '';
let flash: { kind: 'ok' | 'error'; text: string } | null = OK[okKey] ? { kind: 'ok', text: OK[okKey] } : null;

if (Astro.request.method === 'POST') {
  try {
    if (!can(user.role, 'catalog:write')) throw new FormError('Su rol no permite modificar el catálogo.');
    const fd = await readForm(Astro, g);
    const action = str(fd, 'action', 30);

    if (action === 'product') {
      const p = parseProduct(fd);
      await saveProduct(id, p);
      await audit(user, 'product.update', 'product', id, { slug: p.slug, status: p.status }, g.ipHash);
      return Astro.redirect(`/admin/productos/${id}?ok=guardado`, 303);
    }

    if (action === 'variants') {
      const ids = fd.getAll('vid').map((v) => Number(v));
      const stmts = [];
      for (const vid of ids) {
        if (!Number.isInteger(vid)) continue;
        const k = (f: string) => str(fd, `${f}_${vid}`, 120);
        const label_es = k('label_es');
        const label_en = k('label_en');
        if (!label_es || !label_en) throw new FormError('Cada presentación necesita nombre en español e inglés.');
        const grams = parseIntOrNull(k('grams'), 1, 10_000_000);
        if (!grams) throw new FormError(`Peso no válido en «${label_es}».`);
        const price = parseEuros(k('price'));
        const stock = parseIntOrNull(k('stock'), 0, 1_000_000);
        const low = parseIntOrNull(k('low'), 0, 1_000_000);
        const status = k('status') === 'inactive' ? 'inactive' : 'active';
        const sort = parseIntOrNull(k('sort'), 0, 99999) ?? 0;
        stmts.push({
          sql: `UPDATE variants SET label_es = ?, label_en = ?, grams = ?, price_cents = ?, stock = ?, low_stock_threshold = ?, status = ?, sort = ?, updated_at = ?
                WHERE id = ? AND product_id = ?`,
          args: [label_es, label_en, grams, price, stock, low, status, sort, Date.now(), vid, id],
        });
      }
      if (stmts.length) await batch(stmts);
      await audit(user, 'variants.update', 'product', id, { count: stmts.length }, g.ipHash);
      return Astro.redirect(`/admin/productos/${id}?ok=presentaciones`, 303);
    }

    if (action === 'variant_add') {
      const label_es = str(fd, 'label_es', 60);
      const label_en = str(fd, 'label_en', 60) || label_es;
      const grams = parseIntOrNull(str(fd, 'grams', 10), 1, 10_000_000);
      if (!label_es || !grams) throw new FormError('Indique el nombre y el peso en gramos de la presentación.');
      const prod = await get<{ code: string }>('SELECT code FROM products WHERE id = ?', [id]);
      const base = `${(prod?.code || 'SKU').replace(/\s+/g, '')}-${label_es.replace(/\s+/g, '').toUpperCase()}`.slice(0, 40);
      let sku = base;
      for (let i = 2; await get('SELECT id FROM variants WHERE sku = ?', [sku]); i++) sku = `${base}-${i}`;
      await run(
        `INSERT INTO variants (product_id, sku, label_es, label_en, grams, price_cents, stock, status, sort, updated_at)
         VALUES (?, ?, ?, ?, ?, ?, ?, 'active', ?, ?)`,
        [id, sku, label_es, label_en, grams, parseEuros(str(fd, 'price', 20)), parseIntOrNull(str(fd, 'stock', 10), 0, 1_000_000), grams, Date.now()]
      );
      await audit(user, 'variant.create', 'product', id, { sku }, g.ipHash);
      return Astro.redirect(`/admin/productos/${id}?ok=presentacion`, 303);
    }

    if (action === 'variant_delete') {
      if (fd.get('confirmed') !== '1') throw new FormError('Confirme la eliminación.');
      const vid = Number(fd.get('vid'));
      await run('DELETE FROM variants WHERE id = ? AND product_id = ?', [vid, id]);
      await audit(user, 'variant.delete', 'product', id, { vid }, g.ipHash);
      return Astro.redirect(`/admin/productos/${id}?ok=eliminada`, 303);
    }

    if (action === 'image_upload') {
      const rl = await consume(`upload:${user.id}`, LIMITS.upload[0], LIMITS.upload[1]);
      if (!rl.ok) throw new FormError('Demasiadas subidas seguidas. Espere unos minutos.');
      const file = fd.get('image');
      const mediaId = await storeImage(file as File, user.id);
      const sort = (await get<{ n: number }>('SELECT COALESCE(MAX(sort), 0) + 10 AS n FROM product_images WHERE product_id = ?', [id]))?.n ?? 10;
      await run('INSERT INTO product_images (product_id, media_id, alt_es, alt_en, sort) VALUES (?, ?, ?, ?, ?)', [id, mediaId, str(fd, 'alt_es', 160), str(fd, 'alt_en', 160), sort]);
      await run('UPDATE products SET updated_at = ? WHERE id = ?', [Date.now(), id]);
      await audit(user, 'image.upload', 'product', id, { mediaId }, g.ipHash);
      return Astro.redirect(`/admin/productos/${id}?ok=imagen`, 303);
    }

    if (action === 'image_delete') {
      if (fd.get('confirmed') !== '1') throw new FormError('Confirme la eliminación.');
      const imgId = Number(fd.get('image_id'));
      const row = await get<{ media_id: string }>('SELECT media_id FROM product_images WHERE id = ? AND product_id = ?', [imgId, id]);
      if (row) {
        await batch([
          { sql: 'DELETE FROM product_images WHERE id = ?', args: [imgId] },
          { sql: 'DELETE FROM media WHERE id = ? AND NOT EXISTS (SELECT 1 FROM product_images WHERE media_id = ?)', args: [row.media_id, row.media_id] },
        ]);
        await audit(user, 'image.delete', 'product', id, { mediaId: row.media_id }, g.ipHash);
      }
      return Astro.redirect(`/admin/productos/${id}?ok=imagen_eliminada`, 303);
    }

    if (action === 'product_delete') {
      if (!can(user.role, 'catalog:delete')) throw new FormError('Solo un administrador puede eliminar productos. Puede desactivarlo o archivarlo.');
      if (fd.get('confirmed') !== '1') throw new FormError('Confirme la eliminación.');
      const used = await get<{ n: number }>('SELECT COUNT(*) AS n FROM order_items WHERE product_id = ?', [id]);
      if (used && used.n > 0) throw new FormError('Este producto aparece en pedidos registrados: archívelo en lugar de eliminarlo para conservar el historial.');
      await run('DELETE FROM products WHERE id = ?', [id]);
      await audit(user, 'product.delete', 'product', id, {}, g.ipHash);
      return Astro.redirect('/admin/productos', 303);
    }
    throw new FormError('Acción desconocida.');
  } catch (e) {
    if (e instanceof FormError || e instanceof ApiError) flash = { kind: 'error', text: e.message };
    else throw e;
  }
}

const p = await get<ProductRow>('SELECT * FROM products WHERE id = ?', [id]);
if (!p) return Astro.redirect('/admin/productos', 303);
const variants = await all<VariantRow>('SELECT * FROM variants WHERE product_id = ? ORDER BY sort, grams, id', [id]);
const imgs = await all<{ id: number; media_id: string; alt_es: string; alt_en: string }>('SELECT id, media_id, alt_es, alt_en FROM product_images WHERE product_id = ? ORDER BY sort, id', [id]);
const writable = can(user.role, 'catalog:write');
---

<Admin title={`${p.code} — ${p.name_es}`} user={user} csrf={session.csrf} active="products" flash={flash}>
  <div slot="actions" class="adm-actions">
    <a class="adm-btn adm-btn--ghost" href={route('product', 'es', p.slug)} target="_blank" rel="noopener">Ver ficha ↗</a>
    <a class="adm-btn adm-btn--ghost" href="/admin/productos">← Productos</a>
  </div>

  <section class="adm-card">
    <h2>Datos del producto</h2>
    <ProductForm p={p} csrf={session.csrf} readonly={!writable} />
  </section>

  {
    p.kind === 'direct' && (
      <section class="adm-card">
        <h2>Presentaciones, precios e inventario</h2>
        <p class="adm-help">
          Precio en euros por unidad ({'IVA según Ajustes'}). Deje el precio vacío para mostrar «Precio a consultar» y desactivar la compra de esa presentación. Existencias vacías = sin control de stock.
        </p>
        <form method="post" class="adm-form">
          <input type="hidden" name="_csrf" value={session.csrf} />
          <input type="hidden" name="action" value="variants" />
          <div class="adm-table-wrap">
            <table class="adm-table">
              <thead>
                <tr><th>SKU</th><th>Nombre ES</th><th>Nombre EN</th><th>Gramos</th><th>Precio €</th><th>Existencias</th><th>Aviso bajo</th><th>Estado</th><th>Orden</th></tr>
              </thead>
              <tbody>
                {variants.map((v) => (
                  <tr>
                    <td class="muted">
                      {v.sku}
                      <input type="hidden" name="vid" value={v.id} />
                    </td>
                    <td><input class="input input--sm" name={`label_es_${v.id}`} value={v.label_es} maxlength="60" required disabled={!writable} aria-label={`Nombre ES ${v.sku}`} /></td>
                    <td><input class="input input--sm" name={`label_en_${v.id}`} value={v.label_en} maxlength="60" required disabled={!writable} aria-label={`Nombre EN ${v.sku}`} /></td>
                    <td><input class="input input--sm input--stock" name={`grams_${v.id}`} value={v.grams} inputmode="numeric" required disabled={!writable} aria-label={`Gramos ${v.sku}`} /></td>
                    <td><input class="input input--sm input--price" name={`price_${v.id}`} value={centsToInput(v.price_cents)} inputmode="decimal" placeholder="—" disabled={!writable} aria-label={`Precio ${v.sku}`} /></td>
                    <td><input class="input input--sm input--stock" name={`stock_${v.id}`} value={v.stock ?? ''} inputmode="numeric" placeholder="∞" disabled={!writable} aria-label={`Existencias ${v.sku}`} /></td>
                    <td><input class="input input--sm input--stock" name={`low_${v.id}`} value={v.low_stock_threshold ?? ''} inputmode="numeric" placeholder="auto" disabled={!writable} aria-label={`Aviso de stock bajo ${v.sku}`} /></td>
                    <td>
                      <select class="input input--sm" name={`status_${v.id}`} disabled={!writable} aria-label={`Estado ${v.sku}`}>
                        <option value="active" selected={v.status === 'active'}>Activa</option>
                        <option value="inactive" selected={v.status === 'inactive'}>Oculta</option>
                      </select>
                    </td>
                    <td><input class="input input--sm input--stock" name={`sort_${v.id}`} value={v.sort} inputmode="numeric" disabled={!writable} aria-label={`Orden ${v.sku}`} /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {writable && variants.length > 0 && <div class="adm-actions"><button class="adm-btn" type="submit">Guardar presentaciones</button></div>}
        </form>

        {
          writable && (
            <details>
              <summary class="adm-btn adm-btn--ghost adm-btn--sm">Añadir o eliminar presentaciones</summary>
              <form method="post" class="adm-inline">
                <input type="hidden" name="_csrf" value={session.csrf} />
                <input type="hidden" name="action" value="variant_add" />
                <input class="input input--sm" name="label_es" placeholder="Nombre (p. ej. 10 kg)" maxlength="60" required aria-label="Nombre de la presentación" />
                <input class="input input--sm" name="label_en" placeholder="Name (EN)" maxlength="60" aria-label="Nombre en inglés" />
                <input class="input input--sm input--stock" name="grams" placeholder="Gramos" inputmode="numeric" required aria-label="Gramos" />
                <input class="input input--sm input--price" name="price" placeholder="Precio €" inputmode="decimal" aria-label="Precio" />
                <input class="input input--sm input--stock" name="stock" placeholder="Stock" inputmode="numeric" aria-label="Existencias" />
                <button class="adm-btn adm-btn--sm" type="submit">Añadir</button>
              </form>
              <div class="adm-inline">
                {variants.map((v) => (
                  <form method="post" data-confirm={`¿Eliminar la presentación ${v.sku}? Los pedidos ya registrados no se modifican.`}>
                    <input type="hidden" name="_csrf" value={session.csrf} />
                    <input type="hidden" name="action" value="variant_delete" />
                    <input type="hidden" name="vid" value={v.id} />
                    <button class="adm-btn adm-btn--ghost adm-btn--sm" type="submit">Eliminar {v.label_es}</button>
                  </form>
                ))}
              </div>
            </details>
          )
        }
      </section>
    )
  }

  <section class="adm-card">
    <h2>Imágenes del producto</h2>
    <p class="adm-help">JPG, PNG, WebP o AVIF de hasta 8 MB. Se re-codifican a WebP y se eliminan los metadatos (GPS, cámara). La primera imagen sustituye a la fotografía de la galería en la web.</p>
    {
      imgs.length > 0 && (
        <div class="adm-images">
          {imgs.map((im) => (
            <figure>
              <img src={mediaUrl(im.media_id, 480)} alt={im.alt_es} loading="lazy" width="480" height="360" />
              <figcaption>{im.alt_es || 'Sin texto alternativo'}</figcaption>
              {writable && (
                <form method="post" data-confirm="¿Eliminar esta imagen?">
                  <input type="hidden" name="_csrf" value={session.csrf} />
                  <input type="hidden" name="action" value="image_delete" />
                  <input type="hidden" name="image_id" value={im.id} />
                  <button class="adm-btn adm-btn--ghost adm-btn--sm" type="submit">Eliminar</button>
                </form>
              )}
            </figure>
          ))}
        </div>
      )
    }
    {
      writable && (
        <form method="post" enctype="multipart/form-data" class="adm-form">
          <input type="hidden" name="_csrf" value={session.csrf} />
          <input type="hidden" name="action" value="image_upload" />
          <div class="adm-grid adm-grid--3">
            <label class="field"><span>Archivo</span><input class="input" type="file" name="image" accept="image/jpeg,image/png,image/webp,image/avif" required data-preview="upload-preview" /></label>
            <label class="field"><span>Texto alternativo ES</span><input class="input" name="alt_es" maxlength="160" /></label>
            <label class="field"><span>Texto alternativo EN</span><input class="input" name="alt_en" maxlength="160" /></label>
          </div>
          <img id="upload-preview" class="adm-preview" alt="Vista previa" hidden />
          <div class="adm-actions"><button class="adm-btn" type="submit">Subir imagen</button></div>
        </form>
      )
    }
  </section>

  {
    can(user.role, 'catalog:delete') && (
      <section class="adm-card">
        <h2>Eliminar producto</h2>
        <p class="adm-help">Si el producto aparece en pedidos, archívelo desde «Estado» para conservar el historial.</p>
        <form method="post" data-confirm={`¿Eliminar definitivamente ${p.code}? Se borrarán sus presentaciones e imágenes.`}>
          <input type="hidden" name="_csrf" value={session.csrf} />
          <input type="hidden" name="action" value="product_delete" />
          <button class="adm-btn adm-btn--danger" type="submit">Eliminar producto</button>
        </form>
      </section>
    )
  }
</Admin>
