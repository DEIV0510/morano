---
import Admin from '../../../layouts/Admin.astro';
import Pager from '../../../components/admin/Pager.astro';
import { can } from '../../../lib/auth.ts';
import { fmtDate, guard, like, pageParams } from '../../../lib/admin.ts';
import { all, get } from '../../../lib/db.ts';

const g = guard(Astro, 'catalog:read');
if (g instanceof Response) return g;
const { user, session } = g;
const url = Astro.url;
const q = (url.searchParams.get('q') || '').trim().slice(0, 80);
const kind = url.searchParams.get('tipo') || '';
const status = url.searchParams.get('estado') || '';
const { page, size, offset } = pageParams(url, 25);
const where: string[] = [];
const args: (string | number)[] = [];
if (q) {
  where.push("(p.code LIKE ? ESCAPE '\\' OR p.name_es LIKE ? ESCAPE '\\' OR p.name_en LIKE ? ESCAPE '\\' OR p.slug LIKE ? ESCAPE '\\')");
  args.push(like(q), like(q), like(q), like(q));
}
if (kind === 'direct' || kind === 'quote') {
  where.push('p.kind = ?');
  args.push(kind);
}
if (['active', 'inactive', 'archived'].includes(status)) {
  where.push('p.status = ?');
  args.push(status);
}
const w = where.length ? `WHERE ${where.join(' AND ')}` : '';
const total = (await get<{ n: number }>(`SELECT COUNT(*) AS n FROM products p ${w}`, args))?.n ?? 0;
const rows = await all<{ id: number; code: string; name_es: string; kind: string; status: string; variants: number; priced: number; updated_at: number }>(
  `SELECT p.id, p.code, p.name_es, p.kind, p.status, p.updated_at,
     (SELECT COUNT(*) FROM variants v WHERE v.product_id = p.id) AS variants,
     (SELECT COUNT(*) FROM variants v WHERE v.product_id = p.id AND v.price_cents IS NOT NULL) AS priced
   FROM products p ${w} ORDER BY p.sort, p.id LIMIT ? OFFSET ?`,
  [...args, size, offset]
);
const ST: Record<string, string> = { active: 'Activo', inactive: 'Desactivado', archived: 'Archivado' };
---

<Admin title="Productos" user={user} csrf={session.csrf} active="products">
  {can(user.role, 'catalog:write') && <a slot="actions" class="adm-btn" href="/admin/productos/nuevo">Nuevo producto</a>}
  <form class="adm-filters" method="get" role="search">
    <label class="field"><span>Buscar</span><input class="input" type="search" name="q" value={q} placeholder="Código o nombre" maxlength="80" /></label>
    <label class="field">
      <span>Tipo</span>
      <select class="input" name="tipo" data-autosubmit>
        <option value="">Todos</option>
        <option value="direct" selected={kind === 'direct'}>Compra directa</option>
        <option value="quote" selected={kind === 'quote'}>Bajo cotización</option>
      </select>
    </label>
    <label class="field">
      <span>Estado</span>
      <select class="input" name="estado" data-autosubmit>
        <option value="">Todos</option>
        {Object.entries(ST).map(([k, v]) => <option value={k} selected={k === status}>{v}</option>)}
      </select>
    </label>
    <button class="adm-btn" type="submit">Filtrar</button>
  </form>
  <div class="adm-table-wrap">
    {
      rows.length ? (
        <table class="adm-table adm-table--stack">
          <thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Presentaciones</th><th>Estado</th><th>Actualizado</th></tr></thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td data-label="Código"><a href={`/admin/productos/${r.id}`}>{r.code}</a></td>
                <td data-label="Nombre">{r.name_es}</td>
                <td data-label="Tipo">{r.kind === 'direct' ? 'Compra directa' : 'Cotización'}</td>
                <td data-label="Presentaciones">{r.kind === 'direct' ? `${r.variants} (${r.priced} con precio)` : '—'}</td>
                <td data-label="Estado"><span class={`tag tag--${r.status}`}>{ST[r.status]}</span></td>
                <td data-label="Actualizado" class="muted">{fmtDate(r.updated_at)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="adm-empty">No hay productos con estos filtros.</p>
      )
    }
  </div>
  <Pager url={url} page={page} size={size} total={total} />
</Admin>
