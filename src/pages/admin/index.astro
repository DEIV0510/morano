---
import Admin from '../../layouts/Admin.astro';
import { guard, fmtDate, ORDER_LABEL } from '../../lib/admin.ts';
import { all, get } from '../../lib/db.ts';
import { config, smtpConfigured, stripeConfigured } from '../../lib/config.ts';
import { getSettings } from '../../lib/settings.ts';
import { formatMoney } from '../../lib/pricing.ts';

const g = guard(Astro, 'dashboard:view');
if (g instanceof Response) return g;
const { user, session } = g;

const now = Date.now();
const DAY = 86_400_000;
const PAID = "('paid','processing','shipped','delivered')";
const startMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1).getTime();
const settings = await getSettings();

const [byStatus, rev30, revMonth, quotesNew, quotes30, msgsNew, lowStock, unpriced, recent, quoteByProduct, topProducts, weekly] = await Promise.all([
  all<{ status: string; n: number }>('SELECT status, COUNT(*) AS n FROM orders GROUP BY status'),
  get<{ total: number; n: number }>(`SELECT COALESCE(SUM(total_cents),0) AS total, COUNT(*) AS n FROM orders WHERE status IN ${PAID} AND COALESCE(paid_at, created_at) >= ?`, [now - 30 * DAY]),
  get<{ total: number }>(`SELECT COALESCE(SUM(total_cents),0) AS total FROM orders WHERE status IN ${PAID} AND COALESCE(paid_at, created_at) >= ?`, [startMonth]),
  get<{ n: number }>("SELECT COUNT(*) AS n FROM quotes WHERE status = 'new'"),
  get<{ n: number }>('SELECT COUNT(*) AS n FROM quotes WHERE created_at >= ?', [now - 30 * DAY]),
  get<{ n: number }>("SELECT COUNT(*) AS n FROM messages WHERE status = 'new'"),
  all<{ sku: string; stock: number; label_es: string; code: string }>(
    `SELECT v.sku, v.stock, v.label_es, p.code FROM variants v JOIN products p ON p.id = v.product_id
     WHERE v.stock IS NOT NULL AND v.status = 'active' AND v.stock <= COALESCE(v.low_stock_threshold, ?) ORDER BY v.stock LIMIT 8`,
    [settings.lowStockDefault]
  ),
  get<{ n: number }>("SELECT COUNT(*) AS n FROM variants v JOIN products p ON p.id = v.product_id WHERE p.kind = 'direct' AND p.status = 'active' AND v.status = 'active' AND v.price_cents IS NULL"),
  all<{ id: number; ref: string; status: string; total_cents: number; customer_name: string; company: string; created_at: number }>(
    'SELECT id, ref, status, total_cents, customer_name, company, created_at FROM orders ORDER BY created_at DESC LIMIT 6'
  ),
  all<{ label: string; n: number }>('SELECT product_label AS label, COUNT(*) AS n FROM quotes WHERE created_at >= ? GROUP BY product_label ORDER BY n DESC LIMIT 6', [now - 90 * DAY]),
  all<{ name: string; units: number; total: number }>(
    `SELECT oi.product_name AS name, SUM(oi.qty) AS units, SUM(oi.line_total_cents) AS total FROM order_items oi JOIN orders o ON o.id = oi.order_id
     WHERE o.status IN ${PAID} GROUP BY oi.product_name ORDER BY total DESC LIMIT 5`
  ),
  all<{ wk: number; total: number }>(
    `SELECT CAST((COALESCE(paid_at, created_at) - ?) / ? AS INTEGER) AS wk, SUM(total_cents) AS total FROM orders
     WHERE status IN ${PAID} AND COALESCE(paid_at, created_at) >= ? GROUP BY wk`,
    [now - 12 * 7 * DAY, 7 * DAY, now - 12 * 7 * DAY]
  ),
]);
const count = (s: string) => byStatus.find((r) => r.status === s)?.n ?? 0;
const aov = rev30 && rev30.n ? Math.round(rev30.total / rev30.n) : 0;
const weeks = Array.from({ length: 12 }, (_, i) => weekly.find((w) => w.wk === i)?.total ?? 0);
const maxWeek = Math.max(1, ...weeks);
const maxQuote = Math.max(1, ...quoteByProduct.map((q) => q.n));

const me = await get<{ mfa_enabled: number }>('SELECT mfa_enabled FROM users WHERE id = ?', [user.id]);
const checks = [
  { ok: stripeConfigured(), text: 'Pagos con tarjeta (Stripe): claves y webhook configurados' },
  { ok: smtpConfigured(), text: 'Correo transaccional (SMTP) configurado' },
  { ok: Boolean(config.mail.sales), text: 'Buzón comercial (SALES_EMAIL) definido' },
  { ok: (unpriced?.n ?? 0) === 0, text: `Precios fijados en todas las presentaciones${unpriced?.n ? ` (faltan ${unpriced.n})` : ''}` },
  { ok: settings.shippingCents !== null, text: 'Coste de envío configurado' },
  { ok: Boolean(settings.taxId && settings.registry), text: 'Datos legales de la sociedad (NIF y registro)' },
  { ok: Boolean(me?.mfa_enabled), text: 'Su cuenta tiene verificación en dos pasos' },
  { ok: config.siteUrl.startsWith('https://'), text: 'Sitio servido por HTTPS (SITE_URL)' },
];
---

<Admin title="Resumen" user={user} csrf={session.csrf} active="dashboard">
  <section class="kpis" aria-label="Indicadores">
    <div class="kpi">
      <p class="kpi__label">Ventas cobradas · 30 días</p>
      <p class="kpi__value num">{formatMoney(rev30?.total ?? 0, 'es')}</p>
      <p class="kpi__hint">{rev30?.n ?? 0} pedidos · ticket medio {formatMoney(aov, 'es')}</p>
    </div>
    <div class="kpi">
      <p class="kpi__label">Ventas del mes</p>
      <p class="kpi__value num">{formatMoney(revMonth?.total ?? 0, 'es')}</p>
      <p class="kpi__hint">Pedidos pagados o en curso</p>
    </div>
    <div class="kpi kpi--gold">
      <p class="kpi__label">Pedidos por atender</p>
      <p class="kpi__value num">{count('pending') + count('paid') + count('processing')}</p>
      <p class="kpi__hint">{count('pending')} pendientes de pago · {count('paid') + count('processing')} por enviar</p>
    </div>
    <div class="kpi kpi--gold">
      <p class="kpi__label">Cotizaciones nuevas</p>
      <p class="kpi__value num">{quotesNew?.n ?? 0}</p>
      <p class="kpi__hint">{quotes30?.n ?? 0} en 30 días · {msgsNew?.n ?? 0} mensajes nuevos</p>
    </div>
  </section>

  <div class="adm-grid adm-grid--side">
    <div>
      <section class="adm-card">
        <h2>Ventas cobradas por semana (12 semanas)</h2>
        <svg class="chart" viewBox="0 0 600 180" role="img" aria-label="Ventas por semana">
          <line class="chart__axis" x1="0" y1="160" x2="600" y2="160" />
          {
            weeks.map((v, i) => {
              const h = Math.round((v / maxWeek) * 140);
              return (
                <g>
                  <rect x={i * 50 + 8} y={160 - h} width="34" height={Math.max(h, v ? 2 : 0)}>
                    <title>{`Semana ${i + 1}: ${formatMoney(v, 'es')}`}</title>
                  </rect>
                  <text x={i * 50 + 25} y="176" text-anchor="middle">{i === 11 ? 'Actual' : `S-${11 - i}`}</text>
                </g>
              );
            })
          }
        </svg>
      </section>

      <section class="adm-card">
        <h2>Últimos pedidos</h2>
        {
          recent.length ? (
            <div class="adm-table-wrap">
              <table class="adm-table adm-table--stack">
                <thead>
                  <tr><th>Referencia</th><th>Cliente</th><th>Estado</th><th>Fecha</th><th class="num">Total</th></tr>
                </thead>
                <tbody>
                  {recent.map((o) => (
                    <tr>
                      <td data-label="Ref."><a href={`/admin/pedidos/${o.id}`}>{o.ref}</a></td>
                      <td data-label="Cliente">{o.customer_name}{o.company ? ` · ${o.company}` : ''}</td>
                      <td data-label="Estado"><span class={`tag tag--${o.status}`}>{ORDER_LABEL[o.status]}</span></td>
                      <td data-label="Fecha" class="muted">{fmtDate(o.created_at)}</td>
                      <td data-label="Total" class="num">{formatMoney(o.total_cents, 'es')}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="adm-empty">Todavía no hay pedidos.</p>
          )
        }
      </section>

      <section class="adm-card">
        <h2>Cotizaciones por producto (90 días)</h2>
        {
          quoteByProduct.length ? (
            <svg class="chart" viewBox={`0 0 600 ${quoteByProduct.length * 30}`} role="img" aria-label="Cotizaciones por producto">
              {quoteByProduct.map((q, i) => (
                <g>
                  <text x="0" y={i * 30 + 16}>{q.label.slice(0, 38)}</text>
                  <rect x="250" y={i * 30 + 6} width={Math.max(4, Math.round((q.n / maxQuote) * 300))} height="12" />
                  <text x={260 + Math.round((q.n / maxQuote) * 300)} y={i * 30 + 16}>{q.n}</text>
                </g>
              ))}
            </svg>
          ) : (
            <p class="adm-empty">Sin solicitudes en los últimos 90 días.</p>
          )
        }
      </section>
    </div>

    <div>
      <section class="adm-card">
        <h2>Puesta en marcha</h2>
        <ul class="check-list">
          {checks.map((c) => (
            <li><span class={c.ok ? 'ok' : 'no'} aria-hidden="true">{c.ok ? '✓' : '✕'}</span><span>{c.text}<span class="visually-hidden">{c.ok ? ' (listo)' : ' (pendiente)'}</span></span></li>
          ))}
        </ul>
      </section>
      <section class="adm-card">
        <h2>Existencias bajas</h2>
        {
          lowStock.length ? (
            <ul class="check-list">
              {lowStock.map((v) => (
                <li><span class="no">!</span><span>{v.code} {v.label_es} — <strong>{v.stock}</strong> uds.</span></li>
              ))}
            </ul>
          ) : (
            <p class="adm-help">Sin alertas. Las presentaciones sin control de stock no generan avisos.</p>
          )
        }
      </section>
      <section class="adm-card">
        <h2>Productos más vendidos</h2>
        {
          topProducts.length ? (
            <ul class="check-list">
              {topProducts.map((p) => (
                <li><span>·</span><span>{p.name} — {p.units} uds. · {formatMoney(p.total, 'es')}</span></li>
              ))}
            </ul>
          ) : (
            <p class="adm-help">Aún no hay ventas cobradas.</p>
          )
        }
      </section>
    </div>
  </div>
</Admin>
