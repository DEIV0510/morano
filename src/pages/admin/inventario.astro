---
// Vista rápida de precios y existencias de todas las presentaciones de venta directa.
import Admin from '../../layouts/Admin.astro';
import { can } from '../../lib/auth.ts';
import { centsToInput, FormError, guard, parseEuros, parseIntOrNull, readForm } from '../../lib/admin.ts';
import { audit } from '../../lib/audit.ts';
import { all, batch } from '../../lib/db.ts';
import { getSettings } from '../../lib/settings.ts';

const g = guard(Astro, 'catalog:read');
if (g instanceof Response) return g;
const { user, session } = g;
let flash: { kind: 'ok' | 'error'; text: string } | null = Astro.url.searchParams.get('ok') ? { kind: 'ok', text: 'Precios y existencias guardados.' } : null;

if (Astro.request.method === 'POST') {
  try {
    if (!can(user.role, 'inventory:write')) throw new FormError('Su rol no permite modificar precios ni existencias.');
    const fd = await readForm(Astro, g);
    const stmts = [];
    for (const raw of fd.getAll('vid')) {
      const vid = Number(raw);
      if (!Number.isInteger(vid)) continue;
      const price = parseEuros(String(fd.get(`price_${vid}`) ?? ''));
      const stock = parseIntOrNull(String(fd.get(`stock_${vid}`) ?? ''), 0, 1_000_000);
      stmts.push({ sql: 'UPDATE variants SET price_cents = ?, stock = ?, updated_at = ? WHERE id = ?', args: [price, stock, Date.now(), vid] });
    }
    if (stmts.length) await batch(stmts);
    await audit(user, 'inventory.update', 'variants', undefined, { count: stmts.length }, g.ipHash);
    return Astro.redirect('/admin/inventario?ok=1', 303);
  } catch (e) {
    if (e instanceof FormError) flash = { kind: 'error', text: e.message };
    else throw e;
  }
}

const settings = await getSettings();
const rows = await all<{ id: number; sku: string; label_es: string; price_cents: number | null; stock: number | null; low_stock_threshold: number | null; status: string; product_id: number; code: string; name_es: string; p_status: string }>(
  `SELECT v.id, v.sku, v.label_es, v.price_cents, v.stock, v.low_stock_threshold, v.status, p.id AS product_id, p.code, p.name_es, p.status AS p_status
   FROM variants v JOIN products p ON p.id = v.product_id WHERE p.kind = 'direct' ORDER BY p.sort, v.sort, v.grams`
);
const writable = can(user.role, 'inventory:write');
---

<Admin title="Precios e inventario" user={user} csrf={session.csrf} active="inventory" flash={flash}>
  <p class="adm-warn">
    Precios en euros por unidad, {settings.pricesIncludeVat ? 'con' : 'sin'} IVA ({settings.vatRateBp / 100} %) según Ajustes. Precio vacío = «Precio a consultar» (no se puede comprar).
    Existencias vacías = sin control de stock. Al confirmarse un pago, el stock se descuenta automáticamente.
  </p>
  <form method="post" class="adm-form">
    <input type="hidden" name="_csrf" value={session.csrf} />
    <div class="adm-table-wrap">
      <table class="adm-table adm-table--stack">
        <thead><tr><th>Producto</th><th>Presentación</th><th>SKU</th><th>Precio €</th><th>Existencias</th><th>Estado</th></tr></thead>
        <tbody>
          {rows.map((r) => {
            const low = r.stock !== null && r.stock <= (r.low_stock_threshold ?? settings.lowStockDefault);
            return (
              <tr>
                <td data-label="Producto"><a href={`/admin/productos/${r.product_id}`}>{r.code}</a> <span class="adm-help">{r.name_es}</span></td>
                <td data-label="Presentación">{r.label_es}<input type="hidden" name="vid" value={r.id} /></td>
                <td data-label="SKU" class="muted">{r.sku}</td>
                <td data-label="Precio €"><input class="input input--sm input--price" name={`price_${r.id}`} value={centsToInput(r.price_cents)} inputmode="decimal" placeholder="—" disabled={!writable} aria-label={`Precio ${r.sku}`} /></td>
                <td data-label="Existencias"><input class="input input--sm input--stock" name={`stock_${r.id}`} value={r.stock ?? ''} inputmode="numeric" placeholder="∞" disabled={!writable} aria-label={`Existencias ${r.sku}`} />{low && <span class="tag tag--pending"> Bajo</span>}</td>
                <td data-label="Estado">
                  <span class={`tag tag--${r.status === 'active' && r.p_status === 'active' ? 'active' : 'inactive'}`}>
                    {r.p_status !== 'active' ? 'Producto oculto' : r.status === 'active' ? (r.price_cents ? 'A la venta' : 'Sin precio') : 'Oculta'}
                  </span>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    {writable && <div class="adm-actions"><button class="adm-btn" type="submit">Guardar cambios</button></div>}
  </form>
</Admin>
