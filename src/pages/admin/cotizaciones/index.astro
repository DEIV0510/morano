---
import Admin from '../../../layouts/Admin.astro';
import Pager from '../../../components/admin/Pager.astro';
import { fmtDate, guard, like, pageParams, QUOTE_LABEL } from '../../../lib/admin.ts';
import { all, get } from '../../../lib/db.ts';

const g = guard(Astro, 'quotes:read');
if (g instanceof Response) return g;
const { user, session } = g;
const url = Astro.url;
const q = (url.searchParams.get('q') || '').trim().slice(0, 80);
const status = url.searchParams.get('estado') || '';
const product = (url.searchParams.get('producto') || '').slice(0, 64);
const { page, size, offset } = pageParams(url);

const where: string[] = [];
const args: (string | number)[] = [];
if (q) {
  where.push("(ref LIKE ? ESCAPE '\\' OR full_name LIKE ? ESCAPE '\\' OR company LIKE ? ESCAPE '\\' OR email LIKE ? ESCAPE '\\')");
  args.push(like(q), like(q), like(q), like(q));
}
if (status in QUOTE_LABEL) {
  where.push('status = ?');
  args.push(status);
}
if (product) {
  where.push('product_slug = ?');
  args.push(product);
}
const w = where.length ? `WHERE ${where.join(' AND ')}` : '';
const total = (await get<{ n: number }>(`SELECT COUNT(*) AS n FROM quotes ${w}`, args))?.n ?? 0;
const rows = await all<{ id: number; ref: string; status: string; full_name: string; company: string; country: string; product_label: string; volume: string; crm_status: string; created_at: number }>(
  `SELECT id, ref, status, full_name, company, country, product_label, volume, crm_status, created_at FROM quotes ${w} ORDER BY created_at DESC LIMIT ? OFFSET ?`,
  [...args, size, offset]
);
const products = await all<{ slug: string; code: string }>('SELECT slug, code FROM products ORDER BY sort');
---

<Admin title="Cotizaciones" user={user} csrf={session.csrf} active="quotes">
  <form class="adm-filters" method="get" role="search">
    <label class="field">
      <span>Buscar</span>
      <input class="input" type="search" name="q" value={q} placeholder="Referencia, nombre, empresa o correo" maxlength="80" />
    </label>
    <label class="field">
      <span>Estado</span>
      <select class="input" name="estado" data-autosubmit>
        <option value="">Todos</option>
        {Object.entries(QUOTE_LABEL).map(([k, v]) => <option value={k} selected={k === status}>{v}</option>)}
      </select>
    </label>
    <label class="field">
      <span>Producto</span>
      <select class="input" name="producto" data-autosubmit>
        <option value="">Todos</option>
        {products.map((p) => <option value={p.slug} selected={p.slug === product}>{p.code}</option>)}
        <option value="other" selected={product === 'other'}>Otro / varios</option>
      </select>
    </label>
    <button class="adm-btn" type="submit">Filtrar</button>
    {(q || status || product) && <a class="adm-btn adm-btn--ghost" href="/admin/cotizaciones">Limpiar</a>}
  </form>
  <div class="adm-table-wrap">
    {
      rows.length ? (
        <table class="adm-table adm-table--stack">
          <thead>
            <tr><th>Referencia</th><th>Empresa / contacto</th><th>País</th><th>Producto</th><th>Volumen</th><th>Estado</th><th>CRM</th><th>Fecha</th></tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td data-label="Ref."><a href={`/admin/cotizaciones/${r.id}`}>{r.ref}</a></td>
                <td data-label="Empresa">{r.company}<br /><span class="adm-help">{r.full_name}</span></td>
                <td data-label="País">{r.country}</td>
                <td data-label="Producto">{r.product_label}</td>
                <td data-label="Volumen">{r.volume}</td>
                <td data-label="Estado"><span class={`tag tag--${r.status}`}>{QUOTE_LABEL[r.status]}</span></td>
                <td data-label="CRM"><span class={`tag tag--${r.crm_status}`}>{r.crm_status === 'sent' ? 'Enviado' : r.crm_status === 'failed' ? 'Error' : 'No configurado'}</span></td>
                <td data-label="Fecha" class="muted">{fmtDate(r.created_at)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="adm-empty">No hay solicitudes con estos filtros.</p>
      )
    }
  </div>
  <Pager url={url} page={page} size={size} total={total} />
</Admin>
