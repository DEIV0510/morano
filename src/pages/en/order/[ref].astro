---
import OrderPage from '../../../components/OrderPage.astro';
import { findOrderForCustomer } from '../../../lib/orders.ts';
const { ref = '' } = Astro.params;
const q = Astro.url.searchParams;
const found = await findOrderForCustomer(ref, { token: q.get('t'), sessionId: q.get('session_id') });
if (!found) Astro.response.status = 404;
---

<OrderPage locale="en" ref={ref} found={found} />
