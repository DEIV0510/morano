---
import '../styles/base.css';
import '../styles/admin.css';
import { can, ROLE_LABEL, type AdminUser, type Permission } from '../lib/auth.ts';

interface Props {
  title: string;
  user?: AdminUser;
  csrf?: string;
  active?: string;
  flash?: { kind: 'ok' | 'error'; text: string } | null;
}
const { title, user, csrf, active = '', flash } = Astro.props;

const NAV: { href: string; key: string; label: string; perm: Permission }[] = [
  { href: '/admin', key: 'dashboard', label: 'Resumen', perm: 'dashboard:view' },
  { href: '/admin/pedidos', key: 'orders', label: 'Pedidos', perm: 'orders:read' },
  { href: '/admin/cotizaciones', key: 'quotes', label: 'Cotizaciones', perm: 'quotes:read' },
  { href: '/admin/mensajes', key: 'messages', label: 'Mensajes', perm: 'messages:read' },
  { href: '/admin/productos', key: 'products', label: 'Productos', perm: 'catalog:read' },
  { href: '/admin/inventario', key: 'inventory', label: 'Precios e inventario', perm: 'catalog:read' },
  { href: '/admin/contenido', key: 'content', label: 'Textos del sitio', perm: 'content:write' },
  { href: '/admin/ajustes', key: 'settings', label: 'Ajustes', perm: 'settings:write' },
  { href: '/admin/usuarios', key: 'users', label: 'Usuarios y roles', perm: 'users:manage' },
  { href: '/admin/auditoria', key: 'audit', label: 'Actividad y correo', perm: 'audit:read' },
];
const items = user ? NAV.filter((n) => can(user.role, n.perm)) : [];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Panel Morano Europe</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/jost-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="admin">
    <svg class="visually-hidden" aria-hidden="true"><symbol id="adm-mark" viewBox="152 20 236 178"><rect x="273.5" y="35.5" width="101" height="78" fill="none" stroke="#CA9E31" stroke-width="7"></rect><rect x="235.5" y="97.5" width="121" height="89" fill="none" stroke="#7A7A7D" stroke-width="7"></rect><rect x="203.5" y="75.5" width="108" height="52" fill="none" stroke="currentColor" stroke-width="7"></rect><rect x="167.5" y="118.5" width="98" height="54" fill="none" stroke="#CBCDD0" stroke-width="7"></rect></symbol></svg>
    {
      user ? (
        <div class="adm">
          <aside class="adm__side">
            <a class="adm__brand" href="/admin">
              <svg viewBox="152 20 236 178" aria-hidden="true"><use href="#adm-mark" /></svg>
              <span>Morano Europe<small>Panel privado</small></span>
            </a>
            <details class="adm__navwrap" open data-adm-nav>
              <summary>Menú</summary>
              <nav class="adm__nav" aria-label="Panel">
                <ul role="list">
                  {items.map((n) => (
                    <li>
                      <a href={n.href} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
            <div class="adm__me">
              <a href="/admin/cuenta" aria-current={active === 'account' ? 'page' : undefined}>
                <strong>{user.name}</strong>
                <span>{ROLE_LABEL[user.role]}</span>
              </a>
              <form method="post" action="/admin/logout">
                <input type="hidden" name="_csrf" value={csrf} />
                <button class="adm-btn adm-btn--ghost adm-btn--sm" type="submit">Cerrar sesión</button>
              </form>
              <a class="adm__site" href="/es/" target="_blank" rel="noopener">Ver sitio web ↗</a>
            </div>
          </aside>
          <main class="adm__main" id="main">
            <header class="adm__head">
              <h1>{title}</h1>
              <slot name="actions" />
            </header>
            {flash && (
              <p class:list={['adm-flash', `adm-flash--${flash.kind}`]} role={flash.kind === 'error' ? 'alert' : 'status'}>
                {flash.text}
              </p>
            )}
            <slot />
          </main>
        </div>
      ) : (
        <main class="adm-auth" id="main">
          <slot />
        </main>
      )
    }
    <dialog class="adm-confirm" data-confirm-dialog aria-labelledby="confirm-title">
      <form method="dialog">
        <h2 id="confirm-title">Confirmar acción</h2>
        <p data-confirm-text></p>
        <div class="adm-confirm__actions">
          <button class="adm-btn adm-btn--ghost" value="cancel">Cancelar</button>
          <button class="adm-btn adm-btn--danger" value="ok" data-confirm-ok>Confirmar</button>
        </div>
      </form>
    </dialog>
    <script>
      import '../scripts/admin.ts';
    </script>
  </body>
</html>
