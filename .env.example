# ─────────────────────────────────────────────────────────────
# MORANO EUROPE — variables de entorno
# Copia este archivo como .env (local) o configúralas en el hosting.
# Nunca subas el .env al repositorio.
# ─────────────────────────────────────────────────────────────

# URL pública canónica (sin barra final). Se usa en SEO, correos y Stripe.
# También se lee al COMPILAR (npm run build): define los dominios admitidos
# para la comprobación de origen (CSRF). Debe ser el dominio real.
SITE_URL=https://www.moranoeurope.com
# Otros orígenes admitidos (staging, dominio alternativo), separados por comas.
EXTRA_ALLOWED_ORIGINS=

# Servidor Node (adaptador standalone)
HOST=0.0.0.0
PORT=4321

# 1 = hay un proxy/CDN de confianza delante (Caddy, nginx, Cloudflare) que fija
#     X-Forwarded-For / X-Forwarded-Proto. Necesario detrás de un proxy HTTPS.
# 0 = conexiones directas: server.mjs descarta esas cabeceras (no falsificables).
TRUST_PROXY=0

# Secreto de la aplicación: mínimo 32 caracteres aleatorios.
# Firma los tokens antispam, cifra los secretos MFA y seudonimiza las IP.
# Generar:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Base de datos libSQL: archivo local (VPS) o Turso (gestionada).
DATABASE_URL=file:data/morano.db
DATABASE_AUTH_TOKEN=

# Pagos con tarjeta (Stripe Checkout). Sin estas dos claves, los pedidos
# entran como solicitud con factura proforma; nunca se simula un cobro.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Correo transaccional por SMTP (Hostinger, Google Workspace, Brevo, SES…).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Morano Europe <no-reply@moranoeurope.com>
# Buzón comercial que recibe pedidos, cotizaciones y mensajes.
SALES_EMAIL=
# Buzón que recibe alertas de seguridad (bloqueos de cuenta, firmas inválidas).
ALERT_EMAIL=

# Envío opcional de cotizaciones, mensajes y pedidos a un CRM externo
# (HubSpot, Zoho, Make, n8n…). Se firma con HMAC-SHA256 en X-Morano-Signature.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
