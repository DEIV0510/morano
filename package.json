{
  "name": "morano-europe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma corporativa y tienda B2B de Morano Europe SL",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node server.mjs",
    "check": "astro check",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "images": "node scripts/build-images.mjs",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.mjs\"",
    "test:api": "node --test --test-concurrency=1 \"tests/api/*.test.mjs\"",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@libsql/client": "^0.18.0",
    "astro": "^7.4.5",
    "compression": "^1.8.2",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/nodemailer": "^8.0.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
